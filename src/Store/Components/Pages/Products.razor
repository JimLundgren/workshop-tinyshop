@page "/products"
@using DataEntities
@using Store.Services
@inject IConfiguration Configuration
@inject ProductService ProductService
@rendermode InteractiveServer
@attribute [StreamRendering(true)]

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<p>Here are some of our amazing outdoor products that you can purchase.</p>

@if (products == null)
{
    <div class="d-flex align-items-center" aria-live="polite" aria-busy="true">
        <div class="spinner-border spinner-border-sm text-secondary me-2" role="status" aria-hidden="true"></div>
        <span>Loading...</span>
    </div>
}
else
{
    if (products.Count == 0)
    {
        <p>No products found.</p>
    }
    else
    {
        <ul class="products-grid">
            @foreach (var product in products)
            {
                <li class="product-card">
                    <a class="product-card-link" href="@($"/products/{product.Id}")">
                        <img src="@GetImageUrl(product.ImageUrl)"
                             alt="@product.Name"
                             class="product-image" />
                        <div class="product-info">
                            <div class="product-title-price">
                                <h3 class="product-name">@product.Name</h3>
                                <p class="product-price">@product.Price.ToString("C")</p>
                            </div>
                            <p class="product-description">@product.Description</p>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }

}

@code {
    private List<Product>? products;
    private string imagePrefix = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        imagePrefix = Configuration["ImagePrefix"]!;
        products = await ProductService.GetProducts();
    }

    private string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return imagePrefix;
        }

        return $"{imagePrefix}{imageUrl}";
    }

}

<style>
    .product-card-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .product-card-link:hover {
        color: inherit;
        text-decoration: none;
    }

    .product-card-link:focus-visible {
        outline: 2px solid #258cfb;
        outline-offset: 4px;
    }
</style>
